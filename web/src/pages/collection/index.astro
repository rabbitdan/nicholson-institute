---
import Layout from '../../layouts/Layout.astro'
import { sanityClient } from '../../lib/sanity'
import { COLLECTION_INDEX_QUERY, COLLECTION_ITEMS_QUERY } from '../../lib/queries'

// TODO: language comes from the route once language URLs exist. English only for now.
const language = 'en'

const page = await sanityClient.fetch(COLLECTION_INDEX_QUERY, { language })
const items = await sanityClient.fetch(COLLECTION_ITEMS_QUERY, { language })

const title = page?.title ?? 'Collection'

// Filter options come from the items themselves, so there is nothing to keep in sync.
const authors = [...new Set(items.map((item) => item.author).filter(Boolean))].sort()
// The date field is YYYY-MM-DD, so the year is its first four characters.
const years = [...new Set(items.map((item) => item.date?.slice(0, 4)).filter(Boolean))].sort()

function byline(item: { date: string | null; author: string | null }) {
  return [formatDate(item.date), item.author].filter(Boolean).join(' - ')
}

// "1 May 1957". UTC so the day does not shift with the viewer's timezone.
function formatDate(date: string | null) {
  if (!date) return ''
  return new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
}
const tags = [
  ...new Map(items.flatMap((item) => item.tags ?? []).map((tag) => [tag.slug, tag.title])),
].sort((a, b) => a[1].localeCompare(b[1]))
---

<Layout title={title}>
  <section class="index">
    <h1>{title}</h1>
    {page?.intro && <p class="intro">{page.intro}</p>}
    <form class="filters" aria-label="Filter the collection">
      <label>
        Tag
        <select name="tag">
          <option value="">All</option>
          {tags.map(([slug, title]) => <option value={slug}>{title}</option>)}
        </select>
      </label>
      <label>
        Author
        <select name="author">
          <option value="">All</option>
          {authors.map((author) => <option value={author}>{author}</option>)}
        </select>
      </label>
      <label>
        Year
        <select name="year">
          <option value="">All</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
    </form>
    <p class="empty" role="status" hidden>No items match these filters.</p>
    <ul class="items">
      {
        items.map((item) => (
          <li
            data-tags={(item.tags ?? []).map((tag) => tag.slug).join(' ')}
            data-author={item.author ?? ''}
            data-year={item.date?.slice(0, 4) ?? ''}
          >
            <a href={`/collection/${item.slug}`}>
              {item.image?.url && <img src={`${item.image.url}?w=600&h=450&fit=crop`} alt={item.image.alt} width="600" height="450" loading="lazy" />}
              <h2>{item.title}</h2>
              {byline(item) && <p class="byline">{byline(item)}</p>}
              <p>{item.shortDescription}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<script>
  // Filtering happens in the browser: the page is static and the whole collection is already on it.
  const form = document.querySelector<HTMLFormElement>('.filters')!
  const items = document.querySelectorAll<HTMLElement>('.items li')
  const empty = document.querySelector<HTMLElement>('.empty')!

  function applyFilters() {
    const { tag, author, year } = Object.fromEntries(new FormData(form)) as Record<string, string>
    let shown = 0
    for (const item of items) {
      const match =
        (!tag || item.dataset.tags!.split(' ').includes(tag)) &&
        (!author || item.dataset.author === author) &&
        (!year || item.dataset.year === year)
      item.hidden = !match
      if (match) shown++
    }
    empty.hidden = shown > 0
  }

  form.addEventListener('change', applyFilters)
</script>

<style>
  .index {
    padding-block: 3rem;
  }

  h1 {
    margin: 0;
    font-size: 40px;
    font-weight: 700;
    line-height: normal;
    text-transform: uppercase;
  }

  .intro {
    margin: 1rem 0 0;
    max-width: 60ch;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .filters label {
    display: grid;
    gap: 0.25rem;
    font-weight: 700;
  }

  .filters select {
    min-width: 12rem;
    padding: 0.5rem;
    font: inherit;
    font-weight: 400;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 3rem 2rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .items a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  h2 {
    margin: 1rem 0 0;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .byline {
    font-weight: 700;
  }

  p {
    margin: 0.5rem 0 0;
  }
</style>
