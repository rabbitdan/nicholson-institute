---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.vue'
import SiteFooter from '../components/SiteFooter.vue'
import { sanityClient } from '../lib/sanity'
import { HEADER_NAVIGATION_QUERY, FOOTER_QUERY } from '../lib/queries'

type Props = {
  title: string
}

const { title } = Astro.props

// TODO: language comes from the route once language URLs exist. English only for now.
const language = 'en'

const navigation = await sanityClient.fetch(HEADER_NAVIGATION_QUERY, { language })
const footer = await sanityClient.fetch(FOOTER_QUERY, { language })
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="montserrat-400">
    <div class="site">
      <a href="#main" class="skip-link">Skip to main content</a>
      <!-- client:load because the language picker needs JS. -->
      <SiteHeader client:load navigation={navigation} />
      <main id="main">
        <slot />
      </main>
      <!-- No client directive: the footer is static HTML. -->
      <SiteFooter footer={footer} />
    </div>
  </body>
</html>
