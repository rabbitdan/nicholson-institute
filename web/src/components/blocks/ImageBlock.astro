---
const { image, caption } = Astro.props
---

{
  image?.url && (
    <figure>
      <img src={`${image.url}?w=1200`} alt={image.alt ?? ''} loading="lazy" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  figure {
    margin: 0;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.5rem;
  }
</style>
