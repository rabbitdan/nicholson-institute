---
import { getSections, portableTextToHtml } from '../lib/portableText'
import pdfIcon from '../assets/images/pdf-icon.svg'
import type { LEGAL_PAGE_QUERY_RESULT } from '../../sanity.types'

// A legal page: title and text, with a sidebar of links to each section and an optional PDF download.
// The sidebar is built from the Heading 2s in the body.
type Props = {
  page: NonNullable<LEGAL_PAGE_QUERY_RESULT>
}

const { page } = Astro.props
const sections = getSections(page.body)
---

<div class="legal">
  <aside class="sidebar">
    {
      sections.length > 0 && (
        <nav class="sections surface surface--brick" aria-label="On this page">
          <ul>
            {sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>{section.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {
      page.pdfUrl && (
        <a class="download surface surface--greenscape" href={page.pdfUrl} download>
          <span class="download-label">Download</span>
          <img src={pdfIcon.src} width="100" height="103" alt="" />
          <span class="visually-hidden">PDF</span>
        </a>
      )
    }
  </aside>

  <article class="text">
    <h1>{page.title}</h1>
    <div class="body" set:html={portableTextToHtml(page.body)} />
  </article>
</div>

<style>
  .legal {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12);
  }

  /* Sidebar first on small screens, then beside the text. */
  @media (min-width: 64em) {
    .legal {
      grid-template-columns: 19.8125rem minmax(0, 1fr); /* 317px in the design */
      gap: var(--space-16);
      align-items: start;
    }
  }

  .sidebar {
    display: grid;
    gap: var(--space-8);
  }

  .sections {
    padding: var(--space-8);
  }

  .sections ul {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }

  .sections a {
    display: block;
    min-height: var(--target-min);
  }

  .download {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-8);
    text-decoration: none;
  }

  .download-label {
    font-size: var(--text-h3);
    font-weight: 700;
    text-transform: uppercase;
  }

  .download:hover .download-label {
    text-decoration: underline;
  }

  .download img {
    display: block;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  h1 {
    margin: 0 0 var(--space-6);
    font-weight: 700;
  }

  .body :global(h2) {
    margin: var(--space-8) 0 var(--space-6);
    font-size: var(--text-h3);
    font-weight: 700;
    /* Keeps the heading clear of the top of the screen when jumped to. */
    scroll-margin-top: var(--space-8);
  }
</style>
